# Copy this to .env before running docker-compose

# PostgreSQL credentials
POSTGRES_USER=skillswap
POSTGRES_PASSWORD=skillswap
POSTGRES_DB=skillswap

# Backend JWT secret — change this to a strong random string
JWT_SECRET=change-me-to-a-strong-random-secret

# LiveKit video calling (required for /api/v1/video/token)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
